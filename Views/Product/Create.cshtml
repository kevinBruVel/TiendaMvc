@model proyectoSistemas1.Models.Product
@{ ViewData["Title"] = "Nuevo Producto"; }

<h2>Nuevo Producto</h2>
<form asp-action="Create" class="col-md-6">
    <div class="mb-3">
        <label class="form-label">Nombre del Producto</label>
        <input asp-for="ProductName" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Categoría</label>
        <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Proveedor</label>
        <select asp-for="SupplierId" asp-items="ViewBag.SupplierId" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Cantidad por Unidad</label>
        <input asp-for="QuantityPerUnit" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Precio Unitario</label>
        <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Unidades en Stock</label>
        <input asp-for="UnitsInStock" type="number" class="form-control" />
    </div>
    <input type="hidden" asp-for="Discontinued" value="0" />
    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
