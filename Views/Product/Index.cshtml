@model IEnumerable<proyectoSistemas1.Models.Product>
@{ ViewData["Title"] = "Productos"; }

<h2>Catálogo de Productos</h2>
<p><a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a></p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Producto</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.ProductId</td>
            <td>@item.ProductName</td>
            <td>@item.Category?.CategoryName</td>
            <td>@item.Supplier?.CompanyName</td>
            <td>@item.UnitPrice?.ToString("C")</td>
            <td>@item.UnitsInStock</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-sm btn-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
