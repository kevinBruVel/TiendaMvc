@model proyectoSistemas1.Models.Product
@{ ViewData["Title"] = "Eliminar Producto"; }

<h2>¿Eliminar este producto?</h2>
<div class="alert alert-danger col-md-6">
    <p><strong>ID:</strong> @Model.ProductId</p>
    <p><strong>Nombre:</strong> @Model.ProductName</p>
    <p><strong>Precio:</strong> @Model.UnitPrice?.ToString("C")</p>
</div>
<form asp-action="Delete">
    <input type="hidden" asp-for="ProductId" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
